# Node.js dependencies
node_modules/

# macOS system files
**/.DS_Store

# Local run state
active_project.json
.pipeline-state.json

# Workbench (temporary materials)
workbench/_incoming/
workbench/_restore/
workbench/_compare/
workbench/_tmp/

# Business projects (ignore all except demo-task)
projects/*
!projects/demo-task/

# Build artifacts
axhub-make/dist/
axhub-make/admin/
**/dist/

# Lock files (root uses npm, axhub-make uses pnpm - keep root lock only)
axhub-make/pnpm-lock.yaml

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Log files
logs
*.log

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# AI tool configs (may contain API keys)
opencode.json
.claude/

# Archive temp directories
**/.__archiving__/
